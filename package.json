{
  "name": "inkweave-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:engine": "pnpm --filter inkweave-synergy-engine build",
    "build": "pnpm build:engine && tsc -b && vite build",
    "typecheck": "pnpm build:engine && tsc -b",
    "preview": "vite preview",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest",
    "test:run": "pnpm build:engine && vitest run",
    "check:deps": "node scripts/check-shared-deps.mjs",
    "check:hooks": "node scripts/check-hooks.mjs",
    "check:size": "node scripts/check-startup-size.mjs",
    "storybook": "storybook dev -p 6007",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/react": "^11.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "inkweave-synergy-engine": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-loading-skeleton": "^3.5.0",
    "react-router-dom": "^7.18.4",
    "posthog-js": "^1.438.19",
    "@supabase/auth-js": "^2.118.0",
    "@supabase/postgrest-js": "^2.118.0",
    "inkweave-ui": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@sentry/vite-plugin": "^11.8.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "~5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.4",
    "storybook": "^10.6.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "~5.0.5"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  }
}
