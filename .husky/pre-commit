#!/bin/sh
# Lint runs beside the tests, its output held until they finish so the two
# don't interleave; the commit goes through only when both pass. The lint
# script keeps an ESLint cache in node_modules/.cache/eslint/, so a repeat
# lint re-lints only the files that changed.
# A cold lint (no cache yet: a fresh install, or the cache deleted) reads every
# file and loads the same heavy plugins as the tests' ESLint warm-up
# (scripts/bridge-boundary.test.mjs), so it runs first, as it used to.
if [ ! -d node_modules/.cache/eslint ]; then
  pnpm run lint && pnpm run test:run
  exit $?
fi
lint_log=
lint_pid=
# Stop lint and drop its log however the hook ends. A terminal's Ctrl-C reaches
# the ESLint processes too; a kill of the hook alone stops only the top pnpm.
trap 'rc=$?; [ -z "$lint_pid" ] || kill "$lint_pid" 2>/dev/null || :; [ -z "$lint_log" ] || rm -f "$lint_log" || :; exit $rc' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
lint_log=$(mktemp)
FORCE_COLOR=1 pnpm run lint >"$lint_log" 2>&1 &
lint_pid=$!
test_rc=0
pnpm run test:run || test_rc=$?
lint_rc=0
wait "$lint_pid" || lint_rc=$?
lint_pid=
cat "$lint_log"
[ "$lint_rc" -eq 0 ] || echo "pre-commit: lint failed (exit $lint_rc)"
[ "$test_rc" -eq 0 ] || echo "pre-commit: tests failed (exit $test_rc)"
[ "$lint_rc" -eq 0 ] && [ "$test_rc" -eq 0 ]
